# Copie para .env.producao e preencha. Uso:
#   docker compose --env-file .env.producao -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://postgres:SENHA_FORTE@postgres:5432/db
# Gere com: openssl rand -hex 32
JWT_SECRET=
PUBLIC_BASE_URL=https://apichat.seudominio.com.br
APP_URL=https://chat.seudominio.com.br
CORS_ORIGIN=https://chat.seudominio.com.br
# Opcional. Gere com: npx web-push generate-vapid-keys
# Sem isso o servidor gera e guarda as chaves em data/vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
