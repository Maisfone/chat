DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chat_farmacon?schema=public"
# Obrigatório, mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=""
PORT=3000
UPLOAD_DIR="uploads"
# Tamanho máximo de upload em MB (o nginx do cliente limita em 50M)
UPLOAD_MAX_MB=50
PUBLIC_BASE_URL="http://localhost:3000"
# Endereço do frontend: usado no link do e-mail de redefinição de senha
APP_URL="http://localhost:5173"
# Origens permitidas (separadas por vírgula). Em produção, use o domínio do frontend.
CORS_ORIGIN="http://localhost:5173"

# Notificações push (opcional). Gere com: npx web-push generate-vapid-keys
# Se vazio, o servidor gera as chaves e salva em data/vapid.json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@empresa.com"

# Armazenamento
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_BASE=""
S3_OBJECT_ACL="public-read"

# SMTP / envio de email
SMTP_HOST="smtp.seudominio.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Suporte Farmacon <suporte@empresa.com>"

# Seed do Admin (npm run seed:admin cria o admin ou redefine a senha dele)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@empresa.com"
ADMIN_PASSWORD="troque-esta-senha"
